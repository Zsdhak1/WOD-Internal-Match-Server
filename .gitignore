# CMake and compiler output
build/
cmake-build-*/
out/
*.obj
*.pdb
*.ilk
*.exe
*.dll

# FFmpeg is distributed with the Windows release.
!tools/ffmpeg/
!tools/ffmpeg/*.exe
!tools/ffmpeg/*.txt

# Qt Creator local configuration
.qtcreator/
*.user
*.user.*
.qmake.stash

# IDE and local agent state
.vs/
.vscode/
.claude/
.learnings/

# Runtime diagnostics
logs/

# CodeGraph index database (local, regenerated by `codegraph index`)
.codegraph/codegraph.db
.codegraph/cache/

# CodeGraph index (regenerate via `codegraph index`)
.codegraph/
# Local Qt Multimedia merge artifacts
.tools/

# Locally generated layout previews (runtime artwork remains tracked)
/broadcast_center_hud_preview.png
/Assets/processed/center-hud/*_preview.png

# Python caches and private/runtime databases (including interrupted tests)
__pycache__/
*.py[cod]
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*

# Local credentials and crash dumps
.env
.env.*
!.env.example
*.dmp

# Raw source videos for BGM extraction (large; extracted audio is in Assets/bgm)
/Assets/未处理视频/
